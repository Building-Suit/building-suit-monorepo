# CLI/deployment only; copy to .env.production. Never load into Nuxt or commit populated values.
SUPABASE_PROJECT_REF=
SUPABASE_ORGANIZATION_ID=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
