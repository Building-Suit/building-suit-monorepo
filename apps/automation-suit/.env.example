# Local Automation Suit dashboard -> existing control-plane PostgreSQL service.
# The installation guide creates bs_dashboard_reader and constructs this URL.
NUXT_CONTROL_DATABASE_URL=postgresql://bs_dashboard_reader:<reader-password>@127.0.0.1:54329/building_suit_control
NUXT_CONTROL_DATABASE_SSL=disable

# Protect the entire dashboard with HTTP Basic Auth.
NUXT_DASHBOARD_AUTH_REQUIRED=true
NUXT_DASHBOARD_USERNAME=operator
NUXT_DASHBOARD_PASSWORD=replace-me-with-a-different-long-random-password

# Incident thresholds.
NUXT_STALE_TASK_MINUTES=20
NUXT_STALE_EXECUTION_MINUTES=60
NUXT_RUNTIME_HEARTBEAT_SECONDS=120
NUXT_PUBLIC_DASHBOARD_REFRESH_SECONDS=15

APP_URL=http://localhost:3015
