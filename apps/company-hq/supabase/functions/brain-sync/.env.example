# Hosted Edge secrets only. Never copy a service key into the Nuxt app/browser.
# Reuse the dedicated Brain-root Viewer principal; no Google write permission.
HQ_BRAIN_GOOGLE_CLIENT_EMAIL=
HQ_BRAIN_GOOGLE_PRIVATE_KEY=

# Optional reviewed whole-plan JSON source. First let metadata index the file,
# then explicitly bind its file ID/proposal key with hq_brain_bind_manifest.
# Selecting an unbound/malformed source fails closed; it cannot approve a plan.
HQ_BRAIN_PLAN_FILE_ID=

# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are supplied by hosted Supabase.
# The scheduled invocation token is generated in Vault by the operator-only
# configure_brain_scheduler function. Never put it in this file or in the Brain.
