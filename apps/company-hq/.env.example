# HQ only. No other Suit keys, databases, identities or cookies.
HQ_APP_ORIGIN=http://127.0.0.1:3101
# Absolute private path outside the source/public folders; back up this file and its WAL safely.
HQ_DATA_PATH=
# salt:scrypt digest generated with pnpm password:hash via private stdin. No default password.
HQ_FOUNDER_PASSWORD_HASH=
# SHA-256 hashes of independent random >=32-character bridge tokens. Never browser config.
HQ_CEO_TOKEN_SHA256=
HQ_HR_TOKEN_SHA256=
# Required for non-loopback activation only AFTER real host cost/storage/TLS checks; false by default.
HQ_HOSTING_COST_VERIFIED=false
# Founder-selected hosted projects; disabled until project access/scope/plan verified.
HQ_ENVIRONMENT=local
HQ_BACKEND_SCOPE_VERIFIED=false
HQ_SUPABASE_URL=
HQ_SUPABASE_SECRET_KEY=
