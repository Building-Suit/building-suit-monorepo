# Private Google Drive reader. The orb scene works without configuration.
# Enable Drive API; use a dedicated service account shared as Viewer ONLY on
# the fixed building-suit-brain root. No Google Cloud project role is required.
# Populate these from its JSON key privately; never commit the key or values.
# Use literal \n for PEM newlines if needed. Restart the server after changes.
# If organization policy blocks keys, resolve that policy through its owner.
NUXT_HQ_BRAIN_GOOGLE_CLIENT_EMAIL=
NUXT_HQ_BRAIN_GOOGLE_PRIVATE_KEY=

# Dedicated HQ staging Auth/operations project. Publishable key only;
# never put a service-role/secret key in this application configuration.
NUXT_HQ_SUPABASE_URL=https://dpruoncalmwicrqhqelu.supabase.co
NUXT_HQ_SUPABASE_PUBLISHABLE_KEY=
NUXT_HQ_ENVIRONMENT=staging
NUXT_HQ_FOUNDER_EMAIL=ceo@building-suit.com

# Disabled meetings transport. scripts/meeting-preview.mjs enables only an
# isolated, loopback synthetic fixture; never enable it on a hosted deployment.
NUXT_HQ_MEETINGS_DEMO=
NUXT_HQ_MEETINGS_DEMO_DATABASE=
NUXT_HQ_MEETINGS_LIVE=

# Hosted deployments only. Keep empty for the loopback development preview.
# Staging: https://stg.hq.building-suit.com; production: https://hq.building-suit.com
NUXT_HQ_APP_ORIGIN=
