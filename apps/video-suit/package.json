    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "esbuild": "^0.28.2",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.11"
  }
