{
  "name": "@building-suit/video-suit",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare.mjs && nuxt dev --port 3016",
    "build": "node scripts/prepare.mjs && nuxt build",
    "prepare": "node scripts/prepare.mjs && nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
