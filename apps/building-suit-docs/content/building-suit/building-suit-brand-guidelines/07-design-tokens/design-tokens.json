{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "_meta": {
    "name": "Building Suit Design Tokens",
    "version": "1.0.0",
    "description": "Canonical, platform-agnostic design tokens for Building Suit. The platform files (colors.css, tailwind.colors.js, flutter_colors.dart) are generated from or kept in sync with this source.",
    "source": "03-visual-identity/01_COLOR_SYSTEM.md, 02_TYPOGRAPHY_SYSTEM.md, 04_LAYOUT_AND_SPACING.md",
    "keyRule": "The primary action color flips by mode: light = Building Navy, dark = Premium Gold."
  },

  "color": {
    "brand": {
      "buildingNavy": { "value": "#16293B" },
      "deepStructureNavy": { "value": "#0D1B28" },
      "midnightBackground": { "value": "#0A111A" },
      "navySurface": { "value": "#14233A" },
      "navySurfaceRaised": { "value": "#1B2E47" },
      "steelBorder": { "value": "#2E3F52" },
      "premiumGold": { "value": "#D89B42" },
      "highlightGold": { "value": "#EBB45A" },
      "pearlWhite": { "value": "#F7F8FA" },
      "softSilver": { "value": "#E2E5EA" },
      "cloudGray": { "value": "#CBD2DB" },
      "white": { "value": "#FFFFFF" }
    },
    "gold": {
      "700": { "value": "#A86C1C" },
      "600": { "value": "#C8902F" },
      "500": { "value": "#D89B42" },
      "400": { "value": "#EBB45A" },
      "300": { "value": "#F4CE86" }
    },
    "secondary": {
      "slateBlue": { "value": "#36506E" },
      "skySteel": { "value": "#7E97B3" },
      "paleSky": { "value": "#DCE6F1" }
    },
    "neutral": {
      "graphiteText": { "value": "#232B33" },
      "slateGray": { "value": "#5A6573" },
      "steelGray": { "value": "#9AA6B4" }
    },
    "semantic": {
      "success": { "value": "#2E9E6B" },
      "successBg": { "value": "#E4F4EC" },
      "warning": { "value": "#E1841F" },
      "warningBg": { "value": "#FBEEDD" },
      "error": { "value": "#D14B4B" },
      "errorBg": { "value": "#F8E3E3" },
      "info": { "value": "#2F77C9" },
      "infoBg": { "value": "#DCE6F1" },
      "successDark": { "value": "#46B383" },
      "successBgDark": { "value": "#18352A" },
      "warningDark": { "value": "#F09A3C" },
      "warningBgDark": { "value": "#3A2A14" },
      "errorDark": { "value": "#E26A6A" },
      "errorBgDark": { "value": "#3A1E1E" },
      "infoDark": { "value": "#4F92DD" },
      "infoBgDark": { "value": "#15263A" }
    },
    "gradient": {
      "gold": { "value": "linear-gradient(135deg, #EBB45A 0%, #D89B42 50%, #A86C1C 100%)" },
      "navy": { "value": "linear-gradient(160deg, #16293B 0%, #0D1B28 100%)" }
    },
    "role": {
      "light": {
        "background": { "value": "{color.brand.pearlWhite}" },
        "surface": { "value": "{color.brand.white}" },
        "surfaceMuted": { "value": "{color.brand.softSilver}" },
        "surfaceRaised": { "value": "{color.brand.white}" },
        "text": { "value": "{color.neutral.graphiteText}" },
        "textMuted": { "value": "{color.neutral.slateGray}" },
        "textDisabled": { "value": "{color.neutral.steelGray}" },
        "textOnPrimary": { "value": "{color.brand.pearlWhite}" },
        "textOnAccent": { "value": "{color.brand.deepStructureNavy}" },
        "border": { "value": "{color.brand.cloudGray}" },
        "borderStrong": { "value": "{color.neutral.slateGray}" },
        "primary": { "value": "{color.brand.buildingNavy}" },
        "accent": { "value": "{color.brand.premiumGold}" },
        "link": { "value": "{color.secondary.slateBlue}" },
        "focusRing": { "value": "{color.brand.premiumGold}" }
      },
      "dark": {
        "background": { "value": "{color.brand.midnightBackground}" },
        "surface": { "value": "{color.brand.navySurface}" },
        "surfaceMuted": { "value": "{color.brand.deepStructureNavy}" },
        "surfaceRaised": { "value": "{color.brand.navySurfaceRaised}" },
        "text": { "value": "{color.brand.pearlWhite}" },
        "textMuted": { "value": "{color.secondary.skySteel}" },
        "textDisabled": { "value": "#4A5A6E" },
        "textOnPrimary": { "value": "{color.brand.deepStructureNavy}" },
        "textOnAccent": { "value": "{color.brand.deepStructureNavy}" },
        "border": { "value": "{color.brand.steelBorder}" },
        "borderStrong": { "value": "{color.secondary.skySteel}" },
        "primary": { "value": "{color.brand.premiumGold}" },
        "accent": { "value": "{color.brand.highlightGold}" },
        "link": { "value": "{color.secondary.skySteel}" },
        "focusRing": { "value": "{color.brand.highlightGold}" }
      }
    }
  },

  "typography": {
    "fontFamily": {
      "latin": { "value": "Manrope, Inter, system-ui, sans-serif" },
      "arabic": { "value": "'IBM Plex Sans Arabic', Cairo, Tajawal, sans-serif" }
    },
    "fontWeight": {
      "regular": { "value": 400 },
      "medium": { "value": 500 },
      "semibold": { "value": 600 },
      "bold": { "value": 700 },
      "extrabold": { "value": 800 }
    },
    "scale": {
      "display": { "value": { "fontSize": "32px", "lineHeight": "40px", "fontWeight": 800 } },
      "h1": { "value": { "fontSize": "26px", "lineHeight": "34px", "fontWeight": 700 } },
      "h2": { "value": { "fontSize": "22px", "lineHeight": "30px", "fontWeight": 700 } },
      "h3": { "value": { "fontSize": "18px", "lineHeight": "26px", "fontWeight": 600 } },
      "bodyL": { "value": { "fontSize": "16px", "lineHeight": "24px", "fontWeight": 400 } },
      "bodyM": { "value": { "fontSize": "14px", "lineHeight": "22px", "fontWeight": 400 } },
      "caption": { "value": { "fontSize": "12px", "lineHeight": "18px", "fontWeight": 500 } },
      "overline": { "value": { "fontSize": "11px", "lineHeight": "16px", "fontWeight": 600 } },
      "button": { "value": { "fontSize": "15px", "lineHeight": "20px", "fontWeight": 600 } }
    },
    "_note": "Arabic line-heights run +10–15% over the Latin values. Headings ~1.1–1.3; body ~1.5."
  },

  "spacing": {
    "0": { "value": "0px" },
    "1": { "value": "4px" },
    "2": { "value": "8px" },
    "3": { "value": "12px" },
    "4": { "value": "16px" },
    "5": { "value": "24px" },
    "6": { "value": "32px" },
    "7": { "value": "48px" },
    "8": { "value": "64px" },
    "9": { "value": "96px" },
    "_note": "8px base system."
  },

  "radius": {
    "chip": { "value": "8px" },
    "button": { "value": "12px" },
    "input": { "value": "12px" },
    "card": { "value": "16px" },
    "modal": { "value": "24px" },
    "large": { "value": "24px" },
    "full": { "value": "9999px" }
  },

  "shadow": {
    "elevation1": { "value": "0 2px 8px rgba(13, 27, 40, 0.08)" },
    "elevation2": { "value": "0 4px 16px rgba(13, 27, 40, 0.12)" },
    "elevation3": { "value": "0 8px 24px rgba(13, 27, 40, 0.16)" },
    "elevation1Dark": { "value": "0 2px 8px rgba(0, 0, 0, 0.32)" },
    "elevation2Dark": { "value": "0 4px 16px rgba(0, 0, 0, 0.40)" },
    "elevation3Dark": { "value": "0 8px 24px rgba(0, 0, 0, 0.48)" }
  },

  "component": {
    "buttonPrimary": {
      "_note": "Primary action. Color flips by mode — Navy on light, Gold on dark.",
      "radius": { "value": "{radius.button}" },
      "paddingX": { "value": "{spacing.5}" },
      "paddingY": { "value": "{spacing.3}" },
      "typography": { "value": "{typography.scale.button}" },
      "light": {
        "background": { "value": "{color.role.light.primary}" },
        "text": { "value": "{color.role.light.textOnPrimary}" }
      },
      "dark": {
        "background": { "value": "{color.role.dark.primary}" },
        "text": { "value": "{color.role.dark.textOnPrimary}" }
      }
    },
    "card": {
      "radius": { "value": "{radius.card}" },
      "padding": { "value": "{spacing.4}" },
      "light": {
        "background": { "value": "{color.role.light.surface}" },
        "border": { "value": "{color.role.light.border}" },
        "shadow": { "value": "{shadow.elevation1}" }
      },
      "dark": {
        "background": { "value": "{color.role.dark.surface}" },
        "border": { "value": "{color.role.dark.border}" },
        "shadow": { "value": "{shadow.elevation1Dark}" }
      }
    },
    "input": {
      "radius": { "value": "{radius.input}" },
      "paddingX": { "value": "{spacing.4}" },
      "paddingY": { "value": "{spacing.3}" },
      "light": {
        "background": { "value": "{color.role.light.surface}" },
        "border": { "value": "{color.role.light.border}" },
        "text": { "value": "{color.role.light.text}" },
        "focusRing": { "value": "{color.role.light.focusRing}" },
        "error": { "value": "{color.semantic.error}" }
      },
      "dark": {
        "background": { "value": "{color.role.dark.surface}" },
        "border": { "value": "{color.role.dark.border}" },
        "text": { "value": "{color.role.dark.text}" },
        "focusRing": { "value": "{color.role.dark.focusRing}" },
        "error": { "value": "{color.semantic.errorDark}" }
      }
    },
    "chip": {
      "radius": { "value": "{radius.chip}" },
      "paddingX": { "value": "{spacing.3}" },
      "paddingY": { "value": "{spacing.1}" },
      "typography": { "value": "{typography.scale.caption}" }
    },
    "modal": {
      "radius": { "value": "{radius.modal}" },
      "padding": { "value": "{spacing.5}" },
      "light": {
        "background": { "value": "{color.role.light.surface}" },
        "shadow": { "value": "{shadow.elevation3}" },
        "scrim": { "value": "rgba(13, 27, 40, 0.48)" }
      },
      "dark": {
        "background": { "value": "{color.role.dark.surfaceRaised}" },
        "shadow": { "value": "{shadow.elevation3Dark}" },
        "scrim": { "value": "rgba(0, 0, 0, 0.64)" }
      }
    }
  }
}
