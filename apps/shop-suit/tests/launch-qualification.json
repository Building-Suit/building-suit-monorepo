      "name": "shop-launch-baseline-copy-inspection",
      "program": "node",
      "args": [
        "-e",
        "const fs=require('node:fs'),path=require('node:path'),assert=require('node:assert/strict'); const hits=[]; function walk(dir){for(const e of fs.readdirSync(dir,{withFileTypes:true})){const f=path.join(dir,e.name);if(e.isDirectory())walk(f);else if(/\\.(vue|ts|js|json)$/.test(e.name)){const lines=fs.readFileSync(f,'utf8').split('\\n');lines.forEach((line,i)=>{if(/\\b(?:Basic|Pro)\\b/.test(line))hits.push({file:f,line:i+1,text:line.trim()});});}}} walk('apps/shop-suit/app');walk('apps/shop-suit/i18n');console.log(JSON.stringify({scope:'browser-reachable Shop source and i18n',legacy_commercial_wording:hits,internal_compatibility_identifiers:'Lowercase persisted basic/pro identifiers and key names such as proPlanOnly remain technical identifiers; this gate rejects standalone Basic/Pro commercial wording, including EN/AR text.'},null,2));assert.equal(hits.length,0,'Customer-facing legacy Basic/Pro commercial wording remains');"
      ]
    },
