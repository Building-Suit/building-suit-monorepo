[TEMPLATE]
# Copy to .env (or per-app env file) and fill in values. Never commit real values.

# App
NODE_ENV=
# Portal key used for portal resolution.
# Existing cloud portal key (in shop_crm.portals).
PORTAL="shop-crm"
APP_URL=                 # public base URL, e.g. http://127.0.0.1:3000
# Supabase (public/browser-safe)
SUPABASE_URL=            # hosted Supabase project URL
SUPABASE_KEY=            # publishable/anon key — safe for the browser
