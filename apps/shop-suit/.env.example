# Local only. Copy to .env; insert the local publishable key from CLI status.
APP_ENV=local
APP_URL=http://localhost:3001
SUPABASE_URL=http://127.0.0.1:61321
SUPABASE_KEY=

# Production only: APP_ENV=production AND exact https://shop.building-suit.com host.
# Keep absent until GA4 enhanced measurement is disabled and retention reviewed.
NUXT_PUBLIC_GA_MEASUREMENT_ID=
# Optional alternative to existing domain-provider Search Console verification.
NUXT_PUBLIC_SEARCH_CONSOLE_VERIFICATION=

# Non-secret deployment-owned public website suffix. Empty preserves local/prod default.
# Staging requires APP_ENV=staging, NUXT_PUBLIC_APP_ENVIRONMENT=staging and:
# NUXT_PUBLIC_WEBSITE_HOSTNAME_SUFFIX=stg.shops.building-suit.com
# See docs/website-hostname-suffix.md for private origins and operator requirements.
NUXT_PUBLIC_WEBSITE_HOSTNAME_SUFFIX=
