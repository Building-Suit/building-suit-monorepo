# Provider configuration is intentionally absent. Never copy another product session or key.
APP_URL=
APP_ENV=
DOCTOR_SUPABASE_URL=
DOCTOR_SUPABASE_PUBLISHABLE_KEY=
# Private server runtime only: Doctor's own service-role/secret key for the
# restricted yes/no email probe. Never use NUXT_PUBLIC_ or another Suit's key.
DOCTOR_AUTH_EMAIL_LOOKUP_KEY=
# Existing prebuilt Nitro deployments may supply NUXT_DOCTOR_AUTH_EMAIL_LOOKUP_KEY.
# Apply per-instance + trusted-edge/WAF quotas before enabling live signup.
# APP_URL must exactly match the browser origin (localhost and 127.0.0.1 differ).
# For localhost development use APP_ENV=local and APP_URL=http://localhost:3006.
# Restart pnpm dev:doctor after editing. Inspect without exposing values:
# pnpm doctor:auth-check --verify
