# Browser configuration for Inventory Suit production; never put privileged keys here.
APP_ENV=production
APP_URL=https://YOUR_APP_DOMAIN
SUPABASE_URL=https://YOUR_PRODUCTION_PROJECT_REF.supabase.co
SUPABASE_KEY=sb_publishable_REPLACE_ME
NUXT_PUBLIC_SUPABASE_URL=https://YOUR_PRODUCTION_PROJECT_REF.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=sb_publishable_REPLACE_ME
NUXT_PUBLIC_SUPABASE_COOKIE_PREFIX=bs-inventory-production-auth-token
