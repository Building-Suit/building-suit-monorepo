# Browser configuration for ledger-suit staging; never put privileged keys here.
APP_ENV=staging
APP_BASE_URL=https://YOUR_APP_DOMAIN
SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
SUPABASE_KEY=sb_publishable_REPLACE_ME
# Set these matching values on the hosting platform for runtime overrides.
NUXT_PUBLIC_SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=sb_publishable_REPLACE_ME
NUXT_PUBLIC_SUPABASE_COOKIE_PREFIX=bs-ledger-staging-auth-token
