# Copy to .env and keep it uncommitted.
#
# Do NOT put database passwords in this file.
# The scripts prompt for the Supabase postgres password when needed.

LOCAL_CONTROL_HOST=127.0.0.1
LOCAL_CONTROL_PORT=54329
LOCAL_CONTROL_DB=building_suit_control
LOCAL_CONTROL_USER=bs_control_app

# Copy these two values from Supabase:
# Project Dashboard -> Connect -> Session pooler.
STAGING_DB_HOST=
STAGING_PROJECT_REF=

# Session pooler defaults.
STAGING_DB_PORT=5432
STAGING_DB_NAME=postgres

# Admin connection uses postgres.<project-ref>.
# Runtime connection will use bs_control_app.<project-ref>.
