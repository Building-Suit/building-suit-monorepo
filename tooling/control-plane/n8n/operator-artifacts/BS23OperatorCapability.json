{
  "id": "BS23OperatorCapability",
  "name": "BS-23 — Authenticated Operator Capability",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "input",
      "name": "Operator Input",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "command"
            }
          ]
        }
      }
    },
    {
      "id": "validate",
      "name": "Validate Typed Operator Command",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "const command=$input.first().json.command;if(!/^bs-agent operator-gate-resolve [a-f0-9-]{36} [a-f0-9]{32} (approve|reject|revoke) [a-f0-9-]{36}$/i.test(command??''))throw Error('Typed authenticated operator command required');return [{json:{command}}];"
      }
    },
    {
      "id": "ssh",
      "name": "Dedicated Operator SSH Capability",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [
        440,
        0
      ],
      "parameters": {
        "authentication": "privateKey",
        "resource": "command",
        "command": "={{ $json.command }}",
        "cwd": "/"
      },
      "credentials": {
        "sshPrivateKey": {
          "id": "BSControlOperatorSSH",
          "name": "Building Suit Operator Gate"
        }
      }
    },
    {
      "id": "receipt",
      "name": "Read Typed Authority Receipt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "const row=$input.first().json;let payload;try{payload=JSON.parse(row.stdout??'')}catch{throw Error('Malformed operator authority response')}if(Number(row.code??row.exitCode??0)!==0||payload.ok!==true)throw Error(payload.error_code??payload.error??'Operator authority refused');return [{json:{payload,runner_ok:true}}];"
      }
    }
  ],
  "connections": {
    "Operator Input": {
      "main": [
        [
          {
            "node": "Validate Typed Operator Command",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Typed Operator Command": {
      "main": [
        [
          {
            "node": "Dedicated Operator SSH Capability",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Dedicated Operator SSH Capability": {
      "main": [
        [
          {
            "node": "Read Typed Authority Receipt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
