[Unit]
Description=Building Suit private HQ agent worker
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/building-suit-hq-agent-host
EnvironmentFile=/home/ubuntu/.config/building-suit-hq/worker.env
Environment=HQ_CODEX_BIN=/home/ubuntu/.local/bin/codex
Environment=HQ_WORKER_STATE_DIR=/home/ubuntu/.local/state/building-suit-hq-worker
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/node /opt/building-suit-hq-agent-host/worker.mjs
Restart=always
RestartSec=15
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/.codex /home/ubuntu/.local/state/building-suit-hq-worker
MemoryMax=600M
TasksMax=96
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
