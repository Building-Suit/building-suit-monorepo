{
  "name": "building-suit-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "dev:ledger": "pnpm --filter @building-suit/ledger-suit dev --port 3000",
    "dev:shop": "pnpm --filter @building-suit/shop-suit dev --port 3001",
    "dev:docs": "pnpm --filter @building-suit/docs dev --port 3002",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && eslint packages tooling",
    "test": "node --test packages/*/tests/*.test.mjs tooling/database/tests/*.test.mjs tooling/git/tests/*.test.mjs",
    "tokens:generate": "node tooling/design-tokens/generate.mjs",
    "tokens:check": "node tooling/design-tokens/generate.mjs --check",
    "docs:generate": "node tooling/docs/generate.mjs",
    "check": "pnpm tokens:check && node tooling/checks/workspace.mjs",
    "db:test": "pnpm db:test:ledger && pnpm db:test:shop",
    "test:e2e": "playwright test -c packages/testing/playwright.config.ts",
    "setup": "pnpm tokens:generate && pnpm docs:generate && pnpm --filter \"./apps/*\" prepare",
    "table:inventory": "node tooling/ui/inventory.mjs",
    "db:preflight": "node tooling/database/preflight.mjs",
    "new:platform": "node tooling/new-platform/generate.mjs",
    "db:test:ledger": "supabase --workdir apps/ledger-suit test db --local",
    "db:test:shop": "node tooling/database/test-shop-local.mjs",
    "db": "node tooling/database/cli.mjs",
    "agent:preflight": "node tooling/git/preflight.mjs",
    "agent:pr-check": "node tooling/git/check-pr.mjs"
  },
  "devDependencies": {
    "nuxt": "4.5.2",
    "vue": "3.5.42",
    "vue-router": "5.3.0",
    "@nuxtjs/i18n": "10.6.0",
    "@nuxtjs/supabase": "1.6.2",
    "@primevue/nuxt-module": "4.5.5",
    "primevue": "4.5.5",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "@nuxt/eslint": "1.17.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@hugeicons/core-free-icons": "4.2.1",
    "@hugeicons/vue": "1.0.6",
    "zod": "3.25.76",
    "turbo": "2.8.20",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.11",
    "eslint": "9.39.5",
    "@playwright/test": "1.62.1",
    "supabase": "2.116.0",
    "markdown-it": "14.1.0"
  }
}
